const WS_BASE  = "wss://funconnect-v1.funconnect.workers.dev";
const MBLOCK_IDE = "https://ide.mblock.cc/";
const DEFAULT_DEVICE_ID = "cyberpi";
const MLINK_DOWNLOAD = "https://mblock.makeblock.com/en-us/download/";

