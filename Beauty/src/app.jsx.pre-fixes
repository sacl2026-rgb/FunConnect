// Path B (future): a local FunConnect agent bridges the Worker → mLink2, so the
// popup disappears. It answers on a known local endpoint. Detection is
// best-effort — on HTTPS the browser blocks localhost (Private Network Access),
// so this resolves false and we use Path A (popup). Transport is a toggle, not
// a rewrite: catalog + dashboard are identical, only upload differs.
const AGENT_PING = "http://localhost:52384/funconnect/ping";
async function detectAgent(timeoutMs = 1400) {
  const ctrl = new AbortController();
  const t = setTimeout(() => ctrl.abort(), timeoutMs);
  try {
    const r = await fetch(AGENT_PING, { signal: ctrl.signal, cache: "no-store" });
    clearTimeout(t);
    return r.ok;                 // agent present and CORS-enabled
  } catch {
    clearTimeout(t);
    return false;                // absent, refused, or blocked by PNA
  }
}

// ---- flow steps ---------------------------------------------------------
const STEPS = [
  { key: "detect",    label: "Connect Device" },
  { key: "catalog",   label: "Choose Program" },
  { key: "deploy",    label: "Deploy" },
  { key: "dashboard", label: "Live" },
];

// ---- API helpers --------------------------------------------------------
async function getCatalog() {
  const r = await fetch(`${API_BASE}/api/catalog`, { cache: "no-store" });
  if (!r.ok) throw new Error(`catalog HTTP ${r.status}`);
  return r.json();
}
async function getProgramSource(id) {
  const r = await fetch(`${API_BASE}/api/catalog/${encodeURIComponent(id)}`, { cache: "no-store" });
  if (!r.ok) throw new Error(`download HTTP ${r.status}`);
  return r.text();
}
async function getDeviceStatus(id) {
  const r = await fetch(`${API_BASE}/api/device/${encodeURIComponent(id)}/status`, { cache: "no-store" });
  if (!r.ok) throw new Error(`status HTTP ${r.status}`);
  return r.json();
}

// Find the currently-live device. Edge's GET /api/devices lists recently-seen
// ids, but its `online` flags lag the ~44-min rotation (often ALL false) and it
// can omit the live base id after a cycle-back. So we don't trust the flags: we
// gather candidates (listed ids + their base form + the current id) and confirm
// liveness against each device's authoritative /status. Returns {device_id, device_type}
// or null. device_type comes from the roster (device_type field) or falls back to
// status response (device_type field), then to "cyberpi" as last resort.
async function discoverLiveDevice(currentId) {
  let list = [];
  let typeMap = {};   // device_id → device_type from the roster
  try {
    const r = await fetch(`${API_BASE}/api/devices`, { cache: "no-store" });
    if (r.ok) { const d = await r.json(); list = Array.isArray(d) ? d : (d && d.devices) || []; }
  } catch {}
  const norm = list
    .map(x => (typeof x === "string" ? { device_id: x } : x))
    .filter(x => x && x.device_id)
    .sort((a, b) => (b.last_seen || b.last_seen_ms || 0) - (a.last_seen || a.last_seen_ms || 0));
  norm.forEach(x => { if (x.device_type) typeMap[x.device_id] = x.device_type; });

  // Trust an online flag if the endpoint ever sets one truthfully.
  const flagged = norm.find(x => x.online);
  if (flagged) return { device_id: flagged.device_id, device_type: flagged.device_type || typeMap[flagged.device_id] || "cyberpi" };

  // Flags unreliable → verify a handful of best guesses ourselves.
  const base = id => id.replace(/-r\d+$/, "");
  const cands = [];
  const push = id => { if (id && !cands.includes(id)) cands.push(id); };
  norm.slice(0, 4).forEach(x => { push(x.device_id); push(base(x.device_id)); });
  push(currentId); push(base(currentId));
  for (const id of cands) {
    try { const s = await getDeviceStatus(id); if (s && s.online) return { device_id: id, device_type: s.device_type || typeMap[id] || typeMap[base(id)] || "cyberpi" }; } catch {}
  }
  return null;
}

// ---- Auth (Edge builds login / JWT / admin; shapes below are best-effort) ----
const JWT_KEY = "fc_jwt";
function getJwt() { try { return localStorage.getItem(JWT_KEY); } catch { return null; } }

// POST /api/auth/login → { token } (also accepts jwt / access_token). Throws with
// .status on non-2xx so the form can distinguish 401 from other failures.
async function apiLogin(username, password) {
  const r = await fetch(`${API_BASE}/api/auth/login`, {
    method: "POST", headers: { "content-type": "application/json" },
    body: JSON.stringify({ username, password }),
  });
  if (!r.ok) { const e = new Error("login failed"); e.status = r.status; throw e; }
  const d = await r.json().catch(() => ({}));
  return d.token || d.jwt || d.access_token || null;
}

// GET /api/me with the JWT → user object (200) or null (401/unreachable).
async function apiMe(token) {
  try {
    const r = await fetch(`${API_BASE}/api/me`, { headers: { Authorization: `Bearer ${token}` }, cache: "no-store" });
    return r.ok ? await r.json().catch(() => ({})) : null;
  } catch { return null; }
}

// GET /api/admin/devices → tenant devices. Throws {status:401} on expired token.
async function apiAdminDevices(token) {
  const r = await fetch(`${API_BASE}/api/admin/devices`, { headers: { Authorization: `Bearer ${token}` }, cache: "no-store" });
  if (r.status === 401) { const e = new Error("unauthorized"); e.status = 401; throw e; }
  if (!r.ok) return [];
  const d = await r.json().catch(() => []);
  return Array.isArray(d) ? d : (d.devices || []);
}

// The firmware rotates device_id (mbot2-01-r1…r21 → mbot2-01), so the admin list
// is flooded with one physical device's history. Collapse by base id → one row
// per device. Each group tracks aggregate telemetry, latest activity, whether any
// rotation is online, and a `target` id to actually connect to.
const baseId = id => id.replace(/-r\d+$/, "");
function groupDevices(list) {
  const groups = new Map();
  for (const d of list) {
    const id = d.device_id || d.id;
    if (!id) continue;
    const b = baseId(id);
    let g = groups.get(b);
    if (!g) { g = { base: b, online: false, lastSeen: 0, telem: 0, count: 0, onlineId: null, reprId: id, reprLs: -1, deviceType: null }; groups.set(b, g); }
    g.count++;
    g.telem += d.telemetry_count || 0;
    const ls = d.last_seen || d.last_seen_ms || 0;
    if (ls > g.lastSeen) g.lastSeen = ls;
    if (d.online) { g.online = true; g.onlineId = id; }
    if (ls >= g.reprLs) { g.reprLs = ls; g.reprId = id; if (d.device_type) g.deviceType = d.device_type; }
    if (!g.deviceType && d.device_type) g.deviceType = d.device_type;
  }
  const arr = [...groups.values()];
  arr.forEach(g => { g.target = g.onlineId || g.base; });   // connect to the live rotation, else the base id
  arr.sort((a, b) => (b.online ? 1 : 0) - (a.online ? 1 : 0) || b.lastSeen - a.lastSeen);
  return arr;
}

// Download a catalog .hex file to disk (manual save via object URL).
async function downloadHex(programId, programName) {
  try {
    const resp = await fetch(`${API_BASE}/api/catalog/${encodeURIComponent(programId)}`);
    if (!resp.ok) throw new Error(`Catalog download failed (${resp.status})`);
    const blob = await resp.blob();
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `${programName || programId}.hex`;
    a.click();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  } catch (e) {
    console.error("downloadHex:", e);
  }
}

// Save a catalog .hex directly to the micro:bit via showSaveFilePicker.
// Fetches the .hex blob, opens the native file picker so the teacher can
// choose the MICROBIT drive. Falls back to throwing if the API is absent.
async function saveToMicrobit(programId, programName) {
  const resp = await fetch(`${API_BASE}/api/catalog/${encodeURIComponent(programId)}`);
  if (!resp.ok) throw new Error(`Failed to load program (${resp.status})`);
  const blob = await resp.blob();
  if (!("showSaveFilePicker" in window)) throw new Error("File picker not available — use Download instead");
  const handle = await window.showSaveFilePicker({
    suggestedName: `${programName}.hex`,
    id: "funconnect-microbit",
    types: [{ description: "Hex files", accept: { "application/octet-stream": [".hex"] } }],
  });
  const writable = await handle.createWritable();
  await writable.write(blob);
  await writable.close();
}

// Direct .hex firmware write for micro:bit — fetches firmware from Edge, tries
// WebUSB flash first, falls back to MSD (showSaveFilePicker), then download.
// Every async operation has a timeout; every step is a status-based tripwire
// node pushed to onProgress so the UI updates incrementally.
async function saveHexToMicrobit(hexUrl, suggestedName, onProgress) {
  suggestedName = suggestedName || "relay.hex";
  var tree = { label: "Flash with FunConnect", status: "in-progress", children: [] };
  if (onProgress) onProgress(tree);
  var url = hexUrl || API_BASE + "/api/microbit/relay.hex";
  var hexBlob;

  // Fetch — timeout after 10s so a slow catalog API doesn't hang the tree
  var fetchNode = { label: "Fetch firmware", status: "in-progress", children: [] };
  tree.children.push(fetchNode); if (onProgress) onProgress(tree);
  try {
    var resp = await Promise.race([
      fetch(url),
      new Promise(function(_, rej) { setTimeout(function() { rej(new Error("fetch timeout after 10s")); }, 10000); })
    ]);
    if (!resp.ok) throw new Error("HTTP " + resp.status);
    hexBlob = await resp.blob();
    fetchNode.status = "done"; fetchNode.children.push({ label: "Downloaded — " + Math.round(hexBlob.size / 1024) + " KB", status: "done" });
  } catch (e) {
    fetchNode.status = "failed"; fetchNode.children.push({ label: "Failed — " + (e.message||e), status: "failed" });
    tree.status = "failed"; if (onProgress) onProgress(tree); return;
  }

  // WebUSB flash via DAP.js + nrf-intel-hex (imported from webusb-flash.js)
  var wTree = await flashViaWebUSB(hexBlob);
  tree.children.push(wTree);
  if (wTree.status === "done") { tree.status = "done"; if (onProgress) onProgress(tree); return; }

  // MSD fallback — showSaveFilePicker so the user can drag the file onto the micro:bit
  var msdNode = { label: "Save to micro:bit (MSD)", status: "in-progress", children: [] };
  tree.children.push(msdNode); if (onProgress) onProgress(tree);
  try {
    var handle = await window.showSaveFilePicker({ suggestedName: suggestedName, startIn: "documents", types: [{ description: "Firmware", accept: { "application/octet-stream": [".hex"] } }] });
    msdNode.children.push({ label: "Dialog opened", status: "done" });
    var writable = await handle.createWritable();
    msdNode.children.push({ label: "Writable created", status: "done" });
    await writable.write(hexBlob);
    msdNode.children.push({ label: "Write complete", status: "done" });
    await writable.close();
    msdNode.status = "done"; tree.status = "done"; if (onProgress) onProgress(tree); return;
  } catch (e) {
    msdNode.children.push({ label: (e.name==="AbortError"?"Cancelled":"Unavailable — "+(e.message||e)), status: "failed" });
    msdNode.status = "failed";
  }

  // Download fallback — last resort, triggers a browser download
  var dlNode = { label: "Download fallback", status: "in-progress", children: [] };
  tree.children.push(dlNode); if (onProgress) onProgress(tree);
  var objectUrl = URL.createObjectURL(hexBlob);
  var a2 = document.createElement("a"); a2.href = objectUrl; a2.download = suggestedName; a2.click();
  setTimeout(function() { URL.revokeObjectURL(objectUrl); }, 1000);
  dlNode.children.push({ label: "File saved", status: "done" });
  dlNode.status = "done"; tree.status = "done"; if (onProgress) onProgress(tree);
}

// POST /api/chat — Agent AI's RAG pipeline (Edge exposes it). Sends the message +
// device so the LLM can ground its answer in that device's alerts. Not deployed
// yet → 404, handled gracefully in the widget. Response shape (best-effort):
// { reply, context: [ …alerts the answer is grounded in… ] }.
async function postChat(message, deviceId) {
  const token = getJwt();
  const headers = { "content-type": "application/json" };
  if (token) headers.Authorization = `Bearer ${token}`;
  const r = await fetch(`${API_BASE}/api/chat`, {
    method: "POST", headers,
    body: JSON.stringify({ message, device_id: deviceId }),
  });
  if (!r.ok) { const e = new Error("chat failed"); e.status = r.status; throw e; }
  return r.json().catch(() => ({}));
}
const SUGGESTED = ["What just happened?", "Is my device okay?", "Show recent alerts."];
function ctxLabel(c) {
  if (typeof c === "string") return c;
  if (!c) return "alert";
  const cls = c.classification || c.mg?.classification || c.event || "alert";
  const g = c.impact_g != null ? ` · ${c.impact_g}g` : "";
  const ago = c.ago ? ` · ${c.ago}` : "";
  return `${cls}${g}${ago}`;
}

// Open mBlock in a centered, chrome-minimized window that reads as a dialog,
// not a browser tab. Browsers cap what we can hide, but this is the max.
function openMblockPopup() {
  const w = 1020, h = 700;
  const baseLeft = window.screenLeft ?? window.screenX ?? 0;
  const baseTop  = window.screenTop  ?? window.screenY ?? 0;
  const vw = window.innerWidth  || document.documentElement.clientWidth  || screen.width;
  const vh = window.innerHeight || document.documentElement.clientHeight || screen.height;
  const left = Math.max(0, Math.round(baseLeft + (vw - w) / 2));
  const top  = Math.max(0, Math.round(baseTop  + (vh - h) / 2));
  const features = [
    "popup=yes", `width=${w}`, `height=${h}`, `left=${left}`, `top=${top}`,
    "location=no", "menubar=no", "toolbar=no", "status=no", "resizable=yes", "scrollbars=yes",
  ].join(",");
  return window.open(MBLOCK_IDE, "funconnect_mblock", features);
}

// ---- shared UI ----------------------------------------------------------
function Stepper({ current }) {
  const idx = STEPS.findIndex(s => s.key === current);
  return (
    <div className="steps">
      {STEPS.map((s, i) => (
        <div key={s.key} className={"step " + (i === idx ? "active" : i < idx ? "done" : "")}>
          <span className="dot">{i < idx ? "✓" : i + 1}</span>
          {s.label}
        </div>
      ))}
    </div>
  );
}

function StatusPill({ state, label }) {
  const cls = state === "ok" ? "ok" : state === "bad" ? "bad" : state === "wait" ? "wait" : "";
  return <span className={"pill " + cls}><span className="led" />{label}</span>;
}

// Humanize an age in seconds → "just now" / "12s" / "5m" / "3h" / "2d" ago.
function humanAgo(secs) {
  if (secs == null) return "—";
  if (secs < 5) return "just now";
  if (secs < 60) return `${secs}s ago`;
  if (secs < 3600) return `${Math.round(secs / 60)}m ago`;
  if (secs < 86400) return `${Math.round(secs / 3600)}h ago`;
  return `${Math.round(secs / 86400)}d ago`;
}

// Dependency-free confetti burst — celebrates a successful connection.
function Confetti() {
  const ref = useRef(null);
  useEffect(() => {
    const cv = ref.current; if (!cv) return;
    const ctx = cv.getContext("2d");
    const DPR = window.devicePixelRatio || 1;
    const resize = () => { cv.width = window.innerWidth * DPR; cv.height = window.innerHeight * DPR; };
    resize();
    const colors = ["#3db872", "#5ec98f", "#4da6d9", "#f0a030", "#e06060"];
    const parts = Array.from({ length: 170 }, () => ({
      x: (window.innerWidth / 2) * DPR, y: (window.innerHeight * 0.34) * DPR,
      vx: (Math.random() - 0.5) * 15 * DPR, vy: (Math.random() * -13 - 4) * DPR,
      g: 0.36 * DPR, s: (4 + Math.random() * 6) * DPR, rot: Math.random() * 6.28,
      vr: (Math.random() - 0.5) * 0.32, c: colors[(Math.random() * colors.length) | 0],
    }));
    let raf, start = performance.now();
    const tick = (now) => {
      const t = now - start;
      ctx.clearRect(0, 0, cv.width, cv.height);
      for (const p of parts) {
        p.vy += p.g; p.x += p.vx; p.y += p.vy; p.rot += p.vr; p.vx *= 0.99;
        ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(p.rot);
        ctx.globalAlpha = Math.max(0, 1 - t / 2600);
        ctx.fillStyle = p.c; ctx.fillRect(-p.s / 2, -p.s / 2, p.s, p.s * 0.6);
        ctx.restore();
      }
      if (t < 2600) raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);
    window.addEventListener("resize", resize);
    return () => { cancelAnimationFrame(raf); window.removeEventListener("resize", resize); };
  }, []);
  return <canvas ref={ref} className="confetti-canvas" />;
}

