// ../../Projects/FunConnect/Edge/src/roster.ts
import { DurableObject as DurableObject2 } from "cloudflare:workers";
var MIGRATIONS2 = [
  {
    id: 1,
    description: "devices table",
    sql: `CREATE TABLE IF NOT EXISTS devices (
      device_id TEXT PRIMARY KEY,
      device_type TEXT NOT NULL DEFAULT 'cyberpi',
      created_at INTEGER NOT NULL,
      updated_at INTEGER NOT NULL
    )`
  }
];
var TenantRoster = class extends DurableObject2 {
  constructor(ctx, env) {
    super(ctx, env);
    ctx.storage.sql.exec(
      "CREATE TABLE IF NOT EXISTS _migrations (id INTEGER PRIMARY KEY, description TEXT, applied_at INTEGER)"
    );
    for (const m of MIGRATIONS2) {
      const done = ctx.storage.sql.exec(
        "SELECT 1 FROM _migrations WHERE id = ?",
        m.id
      );
      if ([...done].length > 0) continue;
      for (const stmt of m.sql.split(";").map((s) => s.trim()).filter((s) => s.length > 0)) {
        try {
          ctx.storage.sql.exec(stmt);
        } catch {
        }
      }
      ctx.storage.sql.exec(
        "INSERT OR IGNORE INTO _migrations (id, description, applied_at) VALUES (?, ?, ?)",
        m.id,
        m.description,
        Date.now()
      );
    }
  }
  // ── fetch() ────────────────────────────────────────────────────────────
  async fetch(request) {
    const url = new URL(request.url);
    const path = url.pathname;
    const CORS2 = {
      "Content-Type": "application/json",
      "Access-Control-Allow-Origin": "*"
    };
    const json2 = (data, status = 200) => new Response(JSON.stringify(data), { status, headers: CORS2 });
    if (path === "/register" && request.method === "POST") {
      try {
        const body = await request.json();
        if (!body.device_id) return json2({ error: "device_id required" }, 400);
        const now = Date.now();
        this.ctx.storage.sql.exec(
          `INSERT INTO devices (device_id, device_type, created_at, updated_at)
           VALUES (?1, ?2, ?3, ?3)
           ON CONFLICT(device_id) DO UPDATE SET
             device_type = COALESCE(?2, device_type),
             updated_at = ?3`,
          body.device_id,
          body.device_type || "cyberpi",
          now
        );
        return json2({ success: true, device_id: body.device_id });
      } catch (err) {
        return json2({ error: err.message }, 500);
      }
    }
    if (path === "/list" && request.method === "GET") {
      const cursor = this.ctx.storage.sql.exec(
        "SELECT device_id, device_type, created_at, updated_at FROM devices ORDER BY updated_at DESC LIMIT 100"
      );
      const devices = [...cursor].map((r) => ({
        device_id: r.device_id,
        device_type: r.device_type,
        created_at: r.created_at,
        updated_at: r.updated_at
      }));
      return json2({ devices });
    }
    const deviceMatch = path.match(/^\/([^/]+)$/);
    if (deviceMatch && request.method === "GET") {
      const cursor = this.ctx.storage.sql.exec(
        "SELECT device_id, device_type, created_at, updated_at FROM devices WHERE device_id = ?",
        deviceMatch[1]
      );
      const row = [...cursor][0];
      if (!row) return json2({ error: "device not found" }, 404);
      return json2({
        device_id: row.device_id,
        device_type: row.device_type,
        created_at: row.created_at,
        updated_at: row.updated_at
      });
    }
    return json2({ error: "not found" }, 404);
  }
};

