var CATALOG = [
  {
    id: "hello-world",
    name: "Hello World",
    description: "Connect your CyberPi to WiFi and say hello to the cloud. The simplest way to verify your device is online.",
    tags: ["beginner", "wifi", "display"],
    version: "1.0.0",
    content: `# hello-world.py \u2014 FunConnect Catalog
# Flash this to your CyberPi via mBlock to say hello to the cloud.
# After upload, the device connects and appears on your dashboard.

import socket
import ussl
import ustruct
import ujson
import time
import network
from cyberpi import *

# \u2500\u2500 Config \u2500\u2500
WIFI_SSID = "YOUR_WIFI"
WIFI_PASS = "YOUR_PASSWORD"
DEVICE_ID = "cyberpi"
WSS_URL = "ws://funconnect-v1.funconnect.workers.dev/device/" + DEVICE_ID

# \u2500\u2500 Connect WiFi \u2500\u2500
wlan = network.WLAN(network.STA_IF)
wlan.active(True)
wlan.connect(WIFI_SSID, WIFI_PASS)
while not wlan.isconnected():
    time.sleep(0.5)

display.show_label("WiFi OK", 16, 10, 10)

# \u2500\u2500 WebSocket Handshake \u2500\u2500
# (simplified \u2014 real firmware uses a WSS client library)
console.print("Connected! Visit funconnect-v1.funconnect.workers.dev")
`
  },
  {
    id: "led-blink",
    name: "LED Blink",
    description: "Cycle the CyberPi LEDs through colors while reporting state to your cloud dashboard.",
    tags: ["beginner", "led", "dashboard"],
    version: "1.0.0",
    content: `# led-blink.py \u2014 FunConnect Catalog
# Blinks the CyberPi LEDs and reports state to the cloud dashboard.

import time
from cyberpi import *

# \u2500\u2500 Config \u2500\u2500
WIFI_SSID = "YOUR_WIFI"
WIFI_PASS = "YOUR_PASSWORD"
DEVICE_ID = "cyberpi"

console.print("LED Blink starting...")
console.print("Connect to WiFi: " + WIFI_SSID)

# LEDs will cycle through colors while connected
led_colors = [(255,0,0), (0,255,0), (0,0,255), (255,255,0), (255,0,255)]
for i in range(5):
    r, g, b = led_colors[i % 5]
    led.on(r, g, b)
    time.sleep(1)
    led.off()
    time.sleep(0.5)
`
  },
  {
    id: "imu-stream",
    name: "IMU Stream",
    description: "Stream accelerometer and gyroscope data to the cloud. Shake the board to trigger disturbance alerts on your dashboard.",
    tags: ["intermediate", "imu", "alerts", "sensors"],
    version: "1.0.0",
    content: `# imu-stream.py \u2014 FunConnect Catalog
# Streams accelerometer and gyroscope data to the cloud.
# Shake the CyberPi to trigger disturbance alerts.

import time
from cyberpi import *

# \u2500\u2500 Config \u2500\u2500
WIFI_SSID = "YOUR_WIFI"
WIFI_PASS = "YOUR_PASSWORD"
DEVICE_ID = "cyberpi"

console.print("IMU Stream starting...")
console.print("Shake the board to see alerts on the dashboard!")

# The cloud DO runs Madgwick AHRS on disturbance events.
# Your job: send 50-sample 6-DOF ring buffers on impact.
# The firmware handles all of this \u2014 just flash and shake.

prev_acc = (0, 0, 0)
while True:
    ax = accelerometer.get_x()
    ay = accelerometer.get_y()
    az = accelerometer.get_z()
    gx = gyroscope.get_x()
    gy = gyroscope.get_y()
    gz = gyroscope.get_z()

    # Simple jerk detection: any axis delta > threshold = disturbance
    jerk = abs(ax - prev_acc[0]) + abs(ay - prev_acc[1]) + abs(az - prev_acc[2])
    if jerk > 0.5:
        console.print("Disturbance! Jerk: " + str(jerk))

    prev_acc = (ax, ay, az)
    time.sleep(0.04)  # 25 Hz
`
  }
];

// ../../Projects/FunConnect/Edge/src/spa-data.ts
var SPA_HTML = '<!doctype html>\r\n<html lang="en">\r\n<head>\r\n<meta charset="utf-8" />\r\n<meta name="viewport" content="width=device-width, initial-scale=1" />\r\n<title>FunConnect \u2014 plug in, pick a program, go</title>\r\n\r\n<!-- React from CDN. No build step (yet), per Alpha\'s brief. -->\r\n<script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>\r\n<script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>\r\n\r\n<style>\r\n  :root {\r\n    --bg: #0a0e14;\r\n    --panel: #141a26;\r\n    --panel-2: #1a1f2e;\r\n    --line: #26303f;\r\n    --ink: #e8eef6;\r\n    --muted: #8a99ad;\r\n    --brand: #37e0a6;\r\n    --brand-2: #2bb3ff;\r\n    --warn: #ffb454;\r\n    --bad: #ff6b6b;\r\n    --radius: 14px;\r\n    --shadow: 0 10px 40px rgba(0,0,0,.45);\r\n  }\r\n  * { box-sizing: border-box; }\r\n  html, body { margin: 0; height: 100%; }\r\n  body {\r\n    background:\r\n      radial-gradient(1200px 600px at 80% -10%, rgba(43,179,255,.10), transparent),\r\n      radial-gradient(900px 500px at -10% 20%, rgba(55,224,166,.10), transparent),\r\n      var(--bg);\r\n    color: var(--ink);\r\n    font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Inter, system-ui, sans-serif;\r\n    -webkit-font-smoothing: antialiased;\r\n  }\r\n  a { color: var(--brand-2); }\r\n  #root { min-height: 100%; }\r\n\r\n  .wrap { max-width: 1100px; margin: 0 auto; padding: 24px; }\r\n  .brandbar { display:flex; align-items:center; gap:12px; margin-bottom: 8px; }\r\n  .logo {\r\n    width: 34px; height: 34px; border-radius: 9px;\r\n    background: linear-gradient(135deg, var(--brand), var(--brand-2));\r\n    display:grid; place-items:center; color:#04121a; font-weight:800;\r\n    box-shadow: var(--shadow);\r\n  }\r\n  .brandbar h1 { font-size: 18px; margin:0; letter-spacing:.2px; }\r\n  .brandbar .sub { color: var(--muted); font-size: 12.5px; }\r\n\r\n  /* Stepper */\r\n  .steps { display:flex; gap:8px; flex-wrap:wrap; margin: 18px 0 26px; }\r\n  .step {\r\n    display:flex; align-items:center; gap:8px; padding:8px 12px;\r\n    border:1px solid var(--line); border-radius: 999px; color: var(--muted);\r\n    background: var(--panel); font-size: 13px; white-space:nowrap;\r\n  }\r\n  .step .dot {\r\n    width:20px;height:20px;border-radius:50%; display:grid;place-items:center;\r\n    background: var(--panel-2); color: var(--muted); font-size:11px; font-weight:700;\r\n    border:1px solid var(--line);\r\n  }\r\n  .step.active { color: var(--ink); border-color: var(--brand); box-shadow: 0 0 0 1px rgba(55,224,166,.25) inset; }\r\n  .step.active .dot { background: var(--brand); color:#04121a; border-color: var(--brand); }\r\n  .step.done .dot { background: var(--brand-2); color:#03121c; border-color: var(--brand-2); }\r\n\r\n  .card {\r\n    background: var(--panel); border:1px solid var(--line); border-radius: var(--radius);\r\n    box-shadow: var(--shadow); padding: 22px;\r\n  }\r\n  .grid { display:grid; gap:16px; }\r\n  @media (min-width: 860px){ .cols-2 { grid-template-columns: 1fr 1fr; } }\r\n\r\n  h2 { font-size: 20px; margin: 2px 0 6px; }\r\n  h3 { font-size: 15px; margin: 0 0 6px; }\r\n  p.lead { color: var(--muted); margin: 0 0 18px; }\r\n\r\n  .btn {\r\n    appearance:none; border:1px solid transparent; border-radius: 10px;\r\n    padding: 11px 16px; font-weight: 650; font-size: 14px; cursor:pointer;\r\n    background: linear-gradient(135deg, var(--brand), var(--brand-2)); color:#04121a;\r\n    transition: transform .06s ease, filter .15s ease;\r\n  }\r\n  .btn:hover { filter: brightness(1.05); }\r\n  .btn:active { transform: translateY(1px); }\r\n  .btn:disabled { opacity:.45; cursor:not-allowed; filter:none; }\r\n  .btn.ghost { background: transparent; color: var(--ink); border-color: var(--line); }\r\n  .btn.ghost:hover { border-color: var(--brand); }\r\n  .btn.sm { padding: 7px 11px; font-size: 12.5px; border-radius: 8px; }\r\n\r\n  .pill { display:inline-flex; align-items:center; gap:7px; padding:5px 10px; border-radius:999px;\r\n          font-size:12px; border:1px solid var(--line); background: var(--panel-2); color: var(--muted); }\r\n  .pill .led { width:8px;height:8px;border-radius:50%; background: var(--muted); }\r\n  .pill.ok { color: var(--brand); border-color: rgba(55,224,166,.4); }\r\n  .pill.ok .led { background: var(--brand); box-shadow: 0 0 10px var(--brand); }\r\n  .pill.bad { color: var(--bad); border-color: rgba(255,107,107,.4); }\r\n  .pill.bad .led { background: var(--bad); }\r\n  .pill.wait .led { background: var(--warn); animation: blink 1s infinite; }\r\n  @keyframes blink { 50% { opacity:.25; } }\r\n\r\n  .tags { display:flex; gap:6px; flex-wrap:wrap; margin-top:8px; }\r\n  .tag { font-size:11px; color: var(--brand-2); border:1px solid rgba(43,179,255,.35);\r\n         padding:2px 8px; border-radius:999px; text-transform:capitalize; }\r\n\r\n  .catalog { display:grid; gap:12px; grid-template-columns: repeat(auto-fill, minmax(220px,1fr)); }\r\n  .prog {\r\n    background: var(--panel-2); border:1px solid var(--line); border-radius:12px; padding:14px;\r\n    cursor:pointer; transition: border-color .15s ease, transform .06s ease;\r\n  }\r\n  .prog:hover { border-color: var(--brand); }\r\n  .prog.selected { border-color: var(--brand); box-shadow: 0 0 0 1px rgba(55,224,166,.3) inset; }\r\n  .prog h3 { display:flex; justify-content:space-between; align-items:center; gap:8px; }\r\n  .prog .ver { font-size:11px; color: var(--muted); font-weight:500; }\r\n  .prog p { color: var(--muted); font-size:13px; margin:6px 0 0; }\r\n\r\n  .field { display:flex; gap:10px; align-items:center; }\r\n  input[type=text], input[type=password] {\r\n    background: var(--panel-2); border:1px solid var(--line); color: var(--ink);\r\n    padding:10px 12px; border-radius:10px; font-size:14px; width:100%; font-family: ui-monospace, Menlo, monospace;\r\n  }\r\n  input[type=text]:focus, input[type=password]:focus { outline:none; border-color: var(--brand); }\r\n  label.lbl { font-size:12.5px; color: var(--muted); display:block; margin-bottom:6px; }\r\n\r\n  pre.code {\r\n    background:#070b11; border:1px solid var(--line); border-radius:10px; padding:14px;\r\n    overflow:auto; max-height: 340px; font: 12.5px/1.55 ui-monospace, SFMono-Regular, Menlo, monospace;\r\n    color:#cfe3ff; margin:0;\r\n  }\r\n  code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .92em;\r\n         background: rgba(43,179,255,.12); border:1px solid var(--line); padding:1px 5px; border-radius:5px; color:#cfe3ff; }\r\n\r\n  .frame-wrap { position:relative; border:1px solid var(--line); border-radius:12px; overflow:hidden; background:#fff; }\r\n  iframe.mblock { width:100%; height:520px; border:0; display:block; background:#fff; }\r\n  .overlay-note {\r\n    position:absolute; top:10px; left:10px; z-index:5;\r\n    background: rgba(10,14,20,.82); backdrop-filter: blur(4px);\r\n    border:1px solid var(--brand); color: var(--ink);\r\n    border-radius:10px; padding:10px 12px; font-size:12.5px; max-width: 280px;\r\n  }\r\n  .overlay-note b { color: var(--brand); }\r\n\r\n  .guide { display:grid; gap:10px; }\r\n  .guide .g {\r\n    display:flex; gap:12px; align-items:flex-start; padding:12px;\r\n    border:1px solid var(--line); border-radius:10px; background: var(--panel-2);\r\n  }\r\n  .guide .n { flex:0 0 auto; width:24px;height:24px;border-radius:7px; display:grid;place-items:center;\r\n    background: var(--brand); color:#04121a; font-weight:800; font-size:12px; }\r\n  .guide .g.dim { opacity:.55; }\r\n\r\n  .stat { background: var(--panel-2); border:1px solid var(--line); border-radius:12px; padding:14px; }\r\n  .stat .k { color: var(--muted); font-size:12px; text-transform:uppercase; letter-spacing:.06em; }\r\n  .stat .v { font-size:26px; font-weight:750; margin-top:4px; font-variant-numeric: tabular-nums; }\r\n  .stat .u { font-size:13px; color: var(--muted); font-weight:500; }\r\n\r\n  .tiltbox { height:170px; display:grid; place-items:center; position:relative; overflow:hidden;\r\n    border:1px solid var(--line); border-radius:12px; background:\r\n      linear-gradient(180deg, rgba(43,179,255,.06), transparent); }\r\n  .horizon { width:170px; height:170px; position:relative; }\r\n  .plane {\r\n    position:absolute; inset:0; margin:auto; width:150px; height:6px; border-radius:6px;\r\n    background: linear-gradient(90deg, var(--brand-2), var(--brand));\r\n    transition: transform .25s ease; transform-origin:center;\r\n    box-shadow: 0 0 16px rgba(43,179,255,.5);\r\n  }\r\n  .plane::before { content:""; position:absolute; left:50%; top:50%; width:14px;height:14px;\r\n    border-radius:50%; transform:translate(-50%,-50%); background:#fff; box-shadow:0 0 12px #fff; }\r\n\r\n  .row { display:flex; gap:10px; flex-wrap:wrap; align-items:center; }\r\n  .between { display:flex; justify-content:space-between; align-items:center; gap:12px; }\r\n  .muted { color: var(--muted); }\r\n  .err { color: var(--bad); font-size:13px; }\r\n  .hr { height:1px; background: var(--line); margin:18px 0; border:0; }\r\n  .toast {\r\n    position:fixed; bottom:20px; left:50%; transform:translateX(-50%);\r\n    background: var(--panel-2); border:1px solid var(--brand); color: var(--ink);\r\n    padding:10px 16px; border-radius:10px; box-shadow: var(--shadow); z-index:50; font-size:13.5px;\r\n  }\r\n  .success-burst { text-align:center; padding: 30px 10px; }\r\n  .success-burst .ring {\r\n    width:88px;height:88px;border-radius:50%; margin:0 auto 14px;\r\n    display:grid;place-items:center; font-size:40px;\r\n    background: radial-gradient(circle, rgba(55,224,166,.25), transparent 70%);\r\n    border:2px solid var(--brand); color: var(--brand);\r\n    animation: pop .5s ease;\r\n  }\r\n  @keyframes pop { 0%{transform:scale(.6);opacity:0} 60%{transform:scale(1.08)} 100%{transform:scale(1);opacity:1} }\r\n  .spinner { width:16px;height:16px;border-radius:50%; border:2px solid var(--line); border-top-color: var(--brand);\r\n    display:inline-block; animation: spin .8s linear infinite; vertical-align:-3px; }\r\n  @keyframes spin { to { transform: rotate(360deg); } }\r\n\r\n  /* ---- Deploy overlay (bank-grade) ---- */\r\n  .overlay-full {\r\n    position:fixed; inset:0; z-index:60; display:grid; place-items:center; padding:24px;\r\n    background:\r\n      radial-gradient(1200px 700px at 50% -10%, rgba(43,179,255,.12), transparent),\r\n      rgba(6,9,14,.86);\r\n    backdrop-filter: blur(8px); animation: fadein .25s ease;\r\n  }\r\n  .modal {\r\n    width:100%; max-width:640px; background:var(--panel); border:1px solid var(--line);\r\n    border-radius:18px; box-shadow:0 24px 80px rgba(0,0,0,.6); padding:26px;\r\n    animation: modalin .35s cubic-bezier(.2,.7,.2,1);\r\n  }\r\n  @keyframes modalin { from { opacity:0; transform:translateY(12px) scale(.98); } to { opacity:1; transform:none; } }\r\n  @keyframes fadein { from { opacity:0; } to { opacity:1; } }\r\n  .modal-head { display:flex; justify-content:space-between; align-items:flex-start; gap:12px; margin-bottom:18px; }\r\n  .eyebrow { font-size:12px; letter-spacing:.14em; text-transform:uppercase; color:var(--brand); font-weight:750; margin-bottom:3px; }\r\n  .x { background:transparent; border:1px solid var(--line); color:var(--muted); width:34px; height:34px;\r\n       border-radius:9px; cursor:pointer; font-size:14px; transition:.15s; }\r\n  .x:hover { border-color:var(--bad); color:var(--bad); }\r\n\r\n  .progress-dots { display:flex; align-items:center; gap:10px; margin-bottom:24px; }\r\n  .dot-lg { width:30px; height:30px; border-radius:50%; display:grid; place-items:center; font-weight:700;\r\n            font-size:13px; background:var(--panel-2); border:1px solid var(--line); color:var(--muted); transition:.25s; }\r\n  .dot-lg.active { background:var(--brand); color:#04121a; border-color:var(--brand); box-shadow:0 0 0 4px rgba(55,224,166,.18); }\r\n  .dot-lg.done { background:var(--brand-2); color:#03121c; border-color:var(--brand-2); }\r\n  .stepcount { margin-left:auto; font-size:13px; color:var(--muted); }\r\n\r\n  .substep { animation: fadein .3s ease; }\r\n  .substep h3 { font-size:21px; margin:0 0 8px; }\r\n  .substep > p { font-size:16px; color:var(--muted); line-height:1.55; margin:0 0 18px; }\r\n  .illus { display:grid; place-items:center; padding:16px; margin-bottom:18px; border:1px solid var(--line);\r\n           border-radius:14px; background:linear-gradient(180deg, rgba(43,179,255,.06), transparent); }\r\n  .btn.lg { padding:14px 22px; font-size:16px; border-radius:12px; width:100%; }\r\n  .btn.block { display:block; width:100%; }\r\n\r\n  .pulsebar { display:flex; align-items:center; gap:10px; padding:12px 14px; border-radius:12px; margin-bottom:18px;\r\n              border:1px solid rgba(43,179,255,.35); background:rgba(43,179,255,.07); font-size:15px; }\r\n  .pulsedot { width:10px; height:10px; border-radius:50%; background:var(--brand-2);\r\n              box-shadow:0 0 12px var(--brand-2); animation:pulse 1.2s infinite; }\r\n  @keyframes pulse { 0%,100% { opacity:1; transform:scale(1); } 50% { opacity:.35; transform:scale(.7); } }\r\n\r\n  .mini { display:grid; gap:10px; margin:4px 0 18px; }\r\n  .mini .m { display:flex; gap:12px; align-items:flex-start; padding:12px 14px; border:1px solid var(--line);\r\n             border-radius:12px; background:var(--panel-2); font-size:15px; line-height:1.5; }\r\n  .mini .mn { flex:0 0 auto; width:26px; height:26px; border-radius:8px; display:grid; place-items:center;\r\n              background:var(--brand); color:#04121a; font-weight:800; font-size:13px; }\r\n\r\n  .waiting { display:flex; align-items:center; gap:8px; font-size:15px; color:var(--muted); margin-top:6px; }\r\n  .confetti-canvas { position:fixed; inset:0; pointer-events:none; z-index:70; }\r\n  .connected-screen { text-align:center; max-width:520px; }\r\n  .ring-xl { width:104px; height:104px; border-radius:50%; margin:6px auto 14px; display:grid; place-items:center;\r\n             font-size:52px; color:var(--brand); border:3px solid var(--brand);\r\n             background:radial-gradient(circle, rgba(55,224,166,.25), transparent 70%); animation:pop .5s ease; }\r\n\r\n  /* ---- Disturbance alerts ---- */\r\n  .alert-layout { display:grid; gap:16px; }\r\n  @media (min-width: 720px){ .alert-layout { grid-template-columns: 260px 1fr; } }\r\n  .alert-list { display:flex; flex-direction:column; gap:6px; max-height:300px; overflow:auto; }\r\n  .alert-row { display:flex; align-items:center; gap:8px; width:100%; text-align:left; cursor:pointer;\r\n               background:var(--panel-2); border:1px solid var(--line); border-radius:10px; padding:9px 11px;\r\n               color:var(--ink); font-size:13px; transition:.12s; }\r\n  .alert-row:hover { border-color:var(--brand); }\r\n  .alert-row.sel { border-color:var(--brand); box-shadow:0 0 0 1px rgba(55,224,166,.3) inset; }\r\n  .ar-dot { width:9px; height:9px; border-radius:50%; flex:0 0 auto; }\r\n  .ar-cls { text-transform:capitalize; font-weight:650; }\r\n  .ar-meta { color:var(--muted); }\r\n  .ar-time { margin-left:auto; color:var(--muted); font-size:12px; }\r\n\r\n  .alert-detail { background:var(--panel-2); border:1px solid var(--line); border-radius:12px; padding:16px; }\r\n  .class-badge { display:inline-flex; align-items:center; gap:7px; padding:5px 12px; border-radius:999px;\r\n                 border:1px solid; font-size:13px; font-weight:700; text-transform:capitalize; letter-spacing:.02em; }\r\n  .cbdot { width:8px; height:8px; border-radius:50%; }\r\n  .gauge { margin:10px 0; }\r\n  .gauge-top { display:flex; justify-content:space-between; font-size:13px; color:var(--muted); margin-bottom:6px; }\r\n  .gauge-top b { color:var(--ink); font-variant-numeric:tabular-nums; }\r\n  .gauge-track { position:relative; height:8px; border-radius:6px; background:var(--panel);\r\n                 border:1px solid var(--line); overflow:hidden; }\r\n  .gauge-zero { position:absolute; left:50%; top:0; bottom:0; width:1px; background:var(--line); }\r\n  .gauge-fill { position:absolute; top:0; bottom:0; background:linear-gradient(90deg, var(--brand-2), var(--brand)); }\r\n  .dev-input { background:var(--panel-2); border:1px solid var(--line); color:var(--ink); padding:5px 9px;\r\n               border-radius:8px; font:13px ui-monospace, Menlo, monospace; width:160px; }\r\n  .dev-input:focus { outline:none; border-color:var(--brand); }\r\n\r\n  /* ---- Auth + admin ---- */\r\n  .splash { min-height:100vh; display:grid; place-items:center; gap:18px; align-content:center; }\r\n  .logo.lg { width:56px; height:56px; font-size:26px; border-radius:15px; }\r\n  .auth-wrap { min-height:100vh; display:grid; place-items:center; padding:24px; }\r\n  .auth-card { width:100%; max-width:380px; background:var(--panel); border:1px solid var(--line);\r\n               border-radius:16px; padding:26px; box-shadow:var(--shadow); }\r\n  .auth-card .brandbar h1 { font-size:18px; }\r\n  .admin-grid { display:grid; gap:16px; }\r\n  @media (min-width:820px){ .admin-grid { grid-template-columns: 260px 1fr; align-items:start; } }\r\n  .tabbar { display:flex; gap:4px; margin-bottom:18px; border-bottom:1px solid var(--line); }\r\n  .tab { background:transparent; border:0; border-bottom:2px solid transparent; color:var(--muted);\r\n         padding:10px 16px; margin-bottom:-1px; cursor:pointer; font-size:14px; font-weight:650; }\r\n  .tab:hover { color:var(--ink); }\r\n  .tab.active { color:var(--ink); border-bottom-color:var(--brand); }\r\n\r\n  /* ---- Chat widget ---- */\r\n  .chat { display:flex; flex-direction:column; gap:12px; }\r\n  .chat-log { display:flex; flex-direction:column; gap:10px; max-height:340px; overflow:auto; padding-right:4px; }\r\n  .msg { max-width:88%; padding:10px 13px; border-radius:13px; font-size:14px; line-height:1.5; word-wrap:break-word; }\r\n  .msg.user { align-self:flex-end; background:linear-gradient(135deg,var(--brand),var(--brand-2)); color:#04121a; border-bottom-right-radius:4px; }\r\n  .msg.bot { align-self:flex-start; background:var(--panel-2); border:1px solid var(--line); border-bottom-left-radius:4px; }\r\n  .msg.bot.error { border-color:rgba(255,107,107,.4); color:var(--bad); }\r\n  .chat-ctx { margin-top:8px; display:flex; gap:6px; flex-wrap:wrap; }\r\n  .chat-ctx .cx { font-size:11px; padding:2px 8px; border-radius:999px; border:1px solid var(--line);\r\n                  background:var(--panel); color:var(--muted); text-transform:capitalize; }\r\n  .chat-empty { margin-top:8px; font-size:12.5px; color:var(--warn); }\r\n  .typing { display:inline-flex; gap:5px; align-items:center; padding:2px 0; }\r\n  .typing i { width:6px; height:6px; border-radius:50%; background:var(--muted); animation:blink 1.2s infinite; }\r\n  .typing i:nth-child(2){ animation-delay:.2s } .typing i:nth-child(3){ animation-delay:.4s }\r\n  .suggest { display:flex; gap:6px; flex-wrap:wrap; }\r\n  .chat-input { display:flex; gap:8px; }\r\n  .chat-input input { flex:1; width:auto; }\r\n</style>\r\n</head>\r\n<body>\r\n<div id="root"></div>\r\n<div id="fc-diag" style="position:fixed;top:0;left:0;color:#0f0;background:rgba(0,0,0,.85);padding:4px 8px;font:11px monospace;z-index:99999">PAGE LOADED</div>\r\n\r\n<script>\r\n(()=>{var z=null;function he(e){if(!z||!z.writer)return!1;try{return z.writer.write(new TextEncoder().encode(e+`\n`)),!0}catch{return!1}}function fe(e,t,a){let n=new BroadcastChannel("relay");z={port:e,ws:t,deviceId:a,channel:n,writer:i},z.channel=n;let s=e.readable.getReader(),i=e.writable.getWriter(),o=new TextDecoder,l="",r=!1;(async()=>{try{for(;;){let{value:b,done:v}=await s.read();if(v)break;!r&&b&&b.length>0&&(r=!0,n.postMessage({type:"first-byte",deviceId:a})),l+=o.decode(b);let p=l.split(`\n`);l=p.pop();for(let c of p){let m=c.trim();m&&t.readyState===WebSocket.OPEN&&t.send(m)}}}catch{}})(),t.addEventListener("message",b=>{try{i.write(ne